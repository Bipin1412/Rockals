{% doc %}
  @prompt
    Recreate the "Rockals category grid" section but add a custom image upload field for each product card, independent of the product's media. The section should have 4 product card blocks, each with: a product picker, a custom image upload field (so the merchant can choose any image regardless of the product's first image), a label/text field, and a "Shop Now" button linking to the product. The card should display the custom uploaded image if provided, otherwise fall back to the product's featured image. Keep the same dark-luxe premium aesthetic with a clean grid layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_spacing }}px 0;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-category-grid-{{ ai_gen_id }}__inner {
    width: 100%;
  }

  .ai-category-grid-{{ ai_gen_id }}__heading {
    margin: 0 0 28px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-align: {{ block.settings.heading_alignment }};
    text-transform: uppercase;
  }

  .ai-category-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-category-grid-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: {{ block.settings.card_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
  }

  .ai-category-grid-{{ ai_gen_id }}__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: {{ block.settings.image_background }};
    overflow: hidden;
  }

  .ai-category-grid-{{ ai_gen_id }}__media img,
  .ai-category-grid-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-grid-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    color: {{ block.settings.placeholder_color }};
  }

  .ai-category-grid-{{ ai_gen_id }}__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 20px;
  }

  .ai-category-grid-{{ ai_gen_id }}__label {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .ai-category-grid-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    margin-top: auto;
    padding: 10px 18px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-family: {{ block.settings.body_font.family }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-category-grid-{{ ai_gen_id }}__button:hover,
  .ai-category-grid-{{ ai_gen_id }}__button:focus-visible {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-category-grid-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .ai-category-grid-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 549px) {
    .ai-category-grid-{{ ai_gen_id }} { padding: {{ block.settings.mobile_spacing }}px 0; }
    .ai-category-grid-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; }
    .ai-category-grid-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}

<category-grid-{{ ai_gen_id }} class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-category-grid-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-category-grid-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign image_key = 'image_' | append: i
          assign label_key = 'label_' | append: i
          assign product = block.settings[product_key]
          assign custom_image = block.settings[image_key]
          assign label = block.settings[label_key]
        %}
        {% if product != blank %}
          <article class="ai-category-grid-{{ ai_gen_id }}__card">
            <a class="ai-category-grid-{{ ai_gen_id }}__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              {% if custom_image != blank %}
                <img src="{{ custom_image | image_url: width: 900 }}" alt="{{ custom_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">
              {% elsif product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">
              {% else %}
                <div class="ai-category-grid-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>
            <div class="ai-category-grid-{{ ai_gen_id }}__content">
              <p class="ai-category-grid-{{ ai_gen_id }}__label">{{ label | default: product.title | escape }}</p>
              <a class="ai-category-grid-{{ ai_gen_id }}__button" href="{{ product.url }}">{{ block.settings.button_label | escape }}</a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</category-grid-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('category-grid-{{ ai_gen_id }}')) {
      customElements.define('category-grid-{{ ai_gen_id }}', class extends HTMLElement {});
    }
  })();
</script>

{% schema %}
{
  "name": "Rockals category grid",
  "settings": [
    { "type": "header", "content": "Grid content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "header", "content": "Card 1" },
    { "type": "product", "id": "product_1", "label": "Product" },
    { "type": "image_picker", "id": "image_1", "label": "Custom image" },
    { "type": "text", "id": "label_1", "label": "Label", "default": "Featured collection" },
    { "type": "header", "content": "Card 2" },
    { "type": "product", "id": "product_2", "label": "Product" },
    { "type": "image_picker", "id": "image_2", "label": "Custom image" },
    { "type": "text", "id": "label_2", "label": "Label", "default": "New arrivals" },
    { "type": "header", "content": "Card 3" },
    { "type": "product", "id": "product_3", "label": "Product" },
    { "type": "image_picker", "id": "image_3", "label": "Custom image" },
    { "type": "text", "id": "label_3", "label": "Label", "default": "Everyday essentials" },
    { "type": "header", "content": "Card 4" },
    { "type": "product", "id": "product_4", "label": "Product" },
    { "type": "image_picker", "id": "image_4", "label": "Custom image" },
    { "type": "text", "id": "label_4", "label": "Label", "default": "Limited edits" },
    { "type": "header", "content": "Colors and type" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "archivo_black_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "geist_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 16, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "label_size", "label": "Label size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#030206" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#011333" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#0b1933" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f7f3e6" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#35435a" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#aa0236" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#f7f3e6" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#68021f" },
    { "type": "color", "id": "button_hover_text_color", "label": "Hover text", "default": "#f7f3e6" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#8f9aae" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#f7f3e6" }
  ],
  "presets": [{ "name": "Rockals category grid" }],
  "tag": null,
  "class": "rockals-category-grid-block"
}
{% endschema %}