{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; border-top: 1px solid {{ block.settings.border_color }}; }
  .ai-footer-{{ ai_gen_id }}__inner { max-width: {{ block.settings.content_width }}px; margin: 0 auto; padding: {{ block.settings.vertical_padding }}px 24px 20px; }
  .ai-footer-{{ ai_gen_id }}__top { display: grid; grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(150px, 1fr)); gap: 48px; padding-bottom: 52px; }
  .ai-footer-{{ ai_gen_id }}__brand { max-width: 280px; }
  .ai-footer-{{ ai_gen_id }}__brand-name { display: inline-block; margin: 0 0 18px; color: {{ block.settings.accent_color }}; font-size: 28px; font-weight: 800; letter-spacing: 0.08em; line-height: 1; }
  .ai-footer-{{ ai_gen_id }}__tagline { margin: 0; color: {{ block.settings.muted_text_color }}; font-size: 14px; line-height: 1.7; }
  .ai-footer-{{ ai_gen_id }}__heading { margin: 2px 0 20px; color: {{ block.settings.text_color }}; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; line-height: 1.2; text-transform: uppercase; }
  .ai-footer-{{ ai_gen_id }}__list { display: grid; gap: 13px; margin: 0; padding: 0; list-style: none; }
  .ai-footer-{{ ai_gen_id }}__link { color: {{ block.settings.muted_text_color }}; font-size: 14px; line-height: 1.5; text-decoration: none; transition: color 0.2s ease; }
  .ai-footer-{{ ai_gen_id }}__link:hover, .ai-footer-{{ ai_gen_id }}__link:focus-visible { color: {{ block.settings.accent_color }}; text-decoration: underline; text-underline-offset: 4px; }
  .ai-footer-{{ ai_gen_id }}__bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 20px; border-top: 1px solid {{ block.settings.border_color }}; }
  .ai-footer-{{ ai_gen_id }}__copyright { margin: 0; color: {{ block.settings.muted_text_color }}; font-size: 12px; line-height: 1.5; }
  .ai-footer-{{ ai_gen_id }}__accent { width: 42px; height: 3px; background: {{ block.settings.accent_color }}; }
  @media screen and (max-width: 749px) { .ai-footer-{{ ai_gen_id }}__inner { padding-right: 20px; padding-left: 20px; } .ai-footer-{{ ai_gen_id }}__top { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 24px; padding-bottom: 38px; } .ai-footer-{{ ai_gen_id }}__brand { grid-column: 1 / -1; max-width: 100%; } .ai-footer-{{ ai_gen_id }}__bottom { align-items: flex-start; flex-direction: column; } }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-{{ ai_gen_id }}__inner">
    <div class="ai-footer-{{ ai_gen_id }}__top">
      <div class="ai-footer-{{ ai_gen_id }}__brand">
        <p class="ai-footer-{{ ai_gen_id }}__brand-name">{{ block.settings.brand_name }}</p>
        {% if block.settings.tagline != blank %}<p class="ai-footer-{{ ai_gen_id }}__tagline">{{ block.settings.tagline }}</p>{% endif %}
      </div>
      <nav aria-labelledby="ai-footer-links-{{ ai_gen_id }}">
        <h2 id="ai-footer-links-{{ ai_gen_id }}" class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.links_heading }}</h2>
        <ul class="ai-footer-{{ ai_gen_id }}__list">
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.product_link }}">{{ block.settings.product_label }}</a></li>
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.faq_link }}">{{ block.settings.faq_label }}</a></li>
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.size_guide_link }}">{{ block.settings.size_guide_label }}</a></li>
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.contact_link }}">{{ block.settings.contact_label }}</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="ai-footer-policies-{{ ai_gen_id }}">
        <h2 id="ai-footer-policies-{{ ai_gen_id }}" class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.policies_heading }}</h2>
        <ul class="ai-footer-{{ ai_gen_id }}__list">
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.shipping_link }}">{{ block.settings.shipping_label }}</a></li>
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.returns_link }}">{{ block.settings.returns_label }}</a></li>
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.privacy_link }}">{{ block.settings.privacy_label }}</a></li>
          <li><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.terms_link }}">{{ block.settings.terms_label }}</a></li>
        </ul>
      </nav>
    </div>
    <div class="ai-footer-{{ ai_gen_id }}__bottom"><p class="ai-footer-{{ ai_gen_id }}__copyright">{{ block.settings.copyright_text }}</p><span class="ai-footer-{{ ai_gen_id }}__accent" aria-hidden="true"></span></div>
  </div>
</footer>

{% schema %}
{"name":"Modern links footer","settings":[{"type":"header","content":"Brand"},{"type":"text","id":"brand_name","label":"Brand name","default":"ROCKALS"},{"type":"textarea","id":"tagline","label":"Tagline","default":"Premium sneakers and lifestyle essentials, made for every move."},{"type":"text","id":"copyright_text","label":"Copyright","default":"© 2026 ROCKALS. All rights reserved."},{"type":"header","content":"Quick links"},{"type":"text","id":"links_heading","label":"Heading","default":"QUICK LINKS"},{"type":"text","id":"product_label","label":"Product label","default":"Product"},{"type":"url","id":"product_link","label":"Product link"},{"type":"text","id":"faq_label","label":"FAQ label","default":"FAQ"},{"type":"url","id":"faq_link","label":"FAQ link"},{"type":"text","id":"size_guide_label","label":"Size guide label","default":"Size Guide"},{"type":"url","id":"size_guide_link","label":"Size guide link"},{"type":"text","id":"contact_label","label":"Contact label","default":"Contact Us"},{"type":"url","id":"contact_link","label":"Contact link"},{"type":"header","content":"Policies"},{"type":"text","id":"policies_heading","label":"Heading","default":"POLICIES"},{"type":"text","id":"shipping_label","label":"Shipping label","default":"Shipping Policy"},{"type":"url","id":"shipping_link","label":"Shipping link"},{"type":"text","id":"returns_label","label":"Returns label","default":"Return & Refund Policy"},{"type":"url","id":"returns_link","label":"Returns link"},{"type":"text","id":"privacy_label","label":"Privacy label","default":"Privacy Policy"},{"type":"url","id":"privacy_link","label":"Privacy link"},{"type":"text","id":"terms_label","label":"Terms label","default":"Terms & Conditions"},{"type":"url","id":"terms_link","label":"Terms link"},{"type":"header","content":"Style"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1600,"step":100,"unit":"px","default":1200},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":30,"max":100,"step":5,"unit":"px","default":65},{"type":"color","id":"background_color","label":"Background","default":"#030206"},{"type":"color","id":"text_color","label":"Headings","default":"#F7F3E6"},{"type":"color","id":"muted_text_color","label":"Links and details","default":"#C7C2B5"},{"type":"color","id":"accent_color","label":"Accent","default":"#AA0236"},{"type":"color","id":"border_color","label":"Borders","default":"#332D35"}],"presets":[{"name":"Modern links footer"}],"tag":null,"class":"modern-links-footer"}
{% endschema %}