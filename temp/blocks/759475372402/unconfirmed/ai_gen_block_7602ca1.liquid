{% doc %}
  @prompt
    In the "Rockals category grid" block (section ID: template--27883115708786__1788504645c1a1ce32, block ID: template--27883115708786__1788504645c1a1ce32__ai_gen_block_d571903_BLjfPc), add an image_picker setting called "Override Image" (id: override_image) to the block schema. Update the Liquid rendering logic so that if an override image is selected, it uses that image instead of the product's default featured image: assign card_image = block.settings.override_image | default: product.featured_image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .rockals-category-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .rockals-category-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: 16px;
  }

  .rockals-category-grid-{{ ai_gen_id }}__card {
    display: block;
    color: #011333;
    text-decoration: none;
  }

  .rockals-category-grid-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f7f3e6;
  }

  .rockals-category-grid-{{ ai_gen_id }}__title {
    margin: 10px 0 0;
    color: #011333;
    font-size: 16px;
    line-height: 1.3;
  }

  .rockals-category-grid-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background: #f7f3e6;
  }

  .rockals-category-grid-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .rockals-category-grid-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstyle %}

<div class="rockals-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="rockals-category-grid-{{ ai_gen_id }}__grid">
    {% for product in block.settings.products %}
      {% assign card_image = block.settings.override_image | default: product.featured_image %}
      <a class="rockals-category-grid-{{ ai_gen_id }}__card" href="{{ product.url }}">
        {% if card_image != blank %}
          <img
            class="rockals-category-grid-{{ ai_gen_id }}__image"
            src="{{ card_image | image_url: width: 900 }}"
            alt="{{ card_image.alt | default: product.title | escape }}"
            loading="lazy"
            width="{{ card_image.width }}"
            height="{{ card_image.height }}"
          >
        {% else %}
          <div class="rockals-category-grid-{{ ai_gen_id }}__placeholder">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        <h3 class="rockals-category-grid-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Rockals category grid",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "image_picker",
      "id": "override_image",
      "label": "Override Image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Rockals category grid"
    }
  ],
  "tag": null,
  "class": "rockals-category-grid-block"
}
{% endschema %}