{% doc %}
  @prompt
    Fix the Liquid error on line 279 of blocks/ai_gen_block_b01a43f in the Shoe collection grid block. The error is "wrong number of arguments (given 2, expected 1)" — replace any usage of the deprecated img_url filter (which accepted multiple arguments) with the modern image_url filter. For example, replace | img_url: '800x', crop: 'center' with | image_url: width: 800. Also ensure images render correctly in the collection grid.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #011333;
  }

  .ai-collection-grid-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: #011333;
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 32px;
    line-height: 1.1;
    text-align: {{ block.settings.alignment }};
  }

  .ai-collection-grid-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-grid-{{ ai_gen_id }}__card {
    min-width: 0;
    color: #011333;
    text-decoration: none;
  }

  .ai-collection-grid-{{ ai_gen_id }}__image-wrap {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f7f3e6;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-collection-grid-{{ ai_gen_id }}__image-wrap img,
  .ai-collection-grid-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-grid-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    color: #687080;
  }

  .ai-collection-grid-{{ ai_gen_id }}__title {
    margin: 12px 0 0;
    color: #011333;
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 18px;
    line-height: 1.25;
    text-align: {{ block.settings.alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-{{ ai_gen_id }}__items {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
    }

    .ai-collection-grid-{{ ai_gen_id }}__heading {
      font-size: 26px;
    }
  }
{% endstyle %}

<div class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-collection-grid-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.collections != blank %}
    <div class="ai-collection-grid-{{ ai_gen_id }}__items">
      {% for collection in block.settings.collections %}
        <a class="ai-collection-grid-{{ ai_gen_id }}__card" href="{{ collection.url }}">
          <div class="ai-collection-grid-{{ ai_gen_id }}__image-wrap">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 800 }} 800w, {{ collection.featured_image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 749px) 50vw, 25vw"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                width="{{ collection.featured_image.width }}"
                height="{{ collection.featured_image.height }}"
                loading="lazy"
              >
            {% else %}
              <div class="ai-collection-grid-{{ ai_gen_id }}__placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <h3 class="ai-collection-grid-{{ ai_gen_id }}__title">{{ collection.title | escape }}</h3>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-collection-grid-{{ ai_gen_id }}__items">
      {% for i in (1..4) %}
        <div class="ai-collection-grid-{{ ai_gen_id }}__card">
          <div class="ai-collection-grid-{{ ai_gen_id }}__image-wrap ai-collection-grid-{{ ai_gen_id }}__placeholder">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
          </div>
          <h3 class="ai-collection-grid-{{ ai_gen_id }}__title">Add a collection</h3>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Shoe collection grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Shoe collection grid"
    }
  ],
  "tag": null,
  "class": "shoe-collection-grid-block"
}
{% endschema %}