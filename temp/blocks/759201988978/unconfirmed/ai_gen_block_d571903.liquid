    { "type": "color", "id": "background_color", "label": "Background", "default": "#030206" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#030206" },
    { "type": "color", "id": "button_hover_color", "label": "Hover button", "default": "#68021F" },
    { "type": "color", "id": "button_hover_text_color", "label": "Hover text", "default": "#FFFFFF" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#F7F3E6" },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Rockals category grid" }],
  "tag": null,
  "class": "rockals-category-grid-block"
}
