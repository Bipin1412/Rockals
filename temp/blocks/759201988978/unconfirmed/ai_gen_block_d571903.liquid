    { "type": "range", "id": "title_size", "label": "Title size", "min": 30, "max": 100, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "mobile_title_size", "label": "Mobile title size", "min": 24, "max": 70, "step": 2, "unit": "px", "default": 42 },
