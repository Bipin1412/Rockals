{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .rockals-category-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    background: {{ block.settings.background_color }};
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card {
    position: relative;
    min-width: 0;
    height: {{ block.settings.card_height }}px;
    overflow: hidden;
    display: block;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    isolation: isolate;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__image,
  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__image {
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1c1a1b;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__placeholder svg {
    width: 45%;
    height: 45%;
    color: #aaa4a0;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.08) 45%, rgba(0, 0, 0, 0.6));
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__title {
    position: absolute;
    top: {{ block.settings.title_top }}px;
    left: 16px;
    right: 16px;
    z-index: 2;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 800;
    letter-spacing: {{ block.settings.title_spacing }}px;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__button {
    position: absolute;
    bottom: {{ block.settings.button_bottom }}px;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    padding: 14px 24px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card:hover .rockals-cat-card__image,
  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card:focus-visible .rockals-cat-card__image {
    transform: scale(1.08);
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card:hover .rockals-cat-card__button,
  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card:focus-visible .rockals-cat-card__button {
    background: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: -3px;
  }

  @media screen and (max-width: 768px) {
    .rockals-category-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card {
      height: {{ block.settings.mobile_card_height }}px;
    }

    .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__title {
      top: {{ block.settings.mobile_title_top }}px;
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .rockals-category-grid-{{ ai_gen_id }} .rockals-cat-card__button {
      bottom: 28px;
    }
  }
{% endstyle %}

<rockals-category-grid-{{ ai_gen_id }} class="rockals-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..4) %}
    {% liquid
      assign product_key = 'product_' | append: i
      assign label_key = 'label_' | append: i
      assign selected_product = block.settings[product_key]
      assign card_label = block.settings[label_key]
    %}
    <a class="rockals-cat-card" href="{% if selected_product != blank %}{{ selected_product.url }}{% else %}#{% endif %}" aria-label="Shop {{ card_label | escape }}">
      {% if selected_product != blank and selected_product.featured_image != blank %}
        <img class="rockals-cat-card__image" src="{{ selected_product.featured_image | image_url: width: 1600 }}" alt="{{ selected_product.featured_image.alt | default: selected_product.title | escape }}" loading="lazy" width="{{ selected_product.featured_image.width }}" height="{{ selected_product.featured_image.height }}">
      {% else %}
        <div class="rockals-cat-card__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {% endif %}
      <div class="rockals-cat-card__overlay"></div>
      <h2 class="rockals-cat-card__title">{{ card_label | escape }}</h2>
      <span class="rockals-cat-card__button">{{ block.settings.button_label | escape }} →</span>
    </a>
  {% endfor %}
</rockals-category-grid-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Rockals category grid",
  "settings": [
    { "type": "header", "content": "Products" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "text", "id": "label_1", "label": "Label 1", "default": "X LOWS" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "text", "id": "label_2", "label": "Label 2", "default": "AERES" },
