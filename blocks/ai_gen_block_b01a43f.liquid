 
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  .ai-mosaic-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-mosaic__frame-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
    box-sizing: border-box;
  }

  /*
    DESKTOP STRUCTURE

    Small 1 | Small 2 | Featured | Featured
    Small 3 | Small 4 | Featured | Featured
  */

  .ai-mosaic__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    height: {{ block.settings.desktop_height }}px;
    width: 100%;
  }

  .ai-mosaic__card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background: #d8d8d8;
    text-decoration: none;
  }

  /* FEATURED IMAGE RIGHT */

  {% if block.settings.featured_position == 'right' %}

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(3) {
      grid-column: 1;
      grid-row: 2;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(4) {
      grid-column: 2;
      grid-row: 2;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(5) {
      grid-column: 3 / 5;
      grid-row: 1 / 3;
    }

  {% else %}

    /* FEATURED IMAGE LEFT */

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(5) {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(1) {
      grid-column: 3;
      grid-row: 1;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(2) {
      grid-column: 4;
      grid-row: 1;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(3) {
      grid-column: 3;
      grid-row: 2;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(4) {
      grid-column: 4;
      grid-row: 2;
    }

  {% endif %}


  /* IMAGE */

  .ai-mosaic__media-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transition: transform 450ms ease;
  }


  {% if block.settings.enable_hover_zoom %}

    @media (hover: hover) {

      .ai-mosaic__card-{{ ai_gen_id }}:hover
      .ai-mosaic__media-{{ ai_gen_id }} {
        transform: scale(1.04);
      }

    }

  {% endif %}


  /* PLACEHOLDER */

  .ai-mosaic__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #d9d9d9;
  }

  .ai-mosaic__placeholder-{{ ai_gen_id }} svg {
    width: 40%;
    height: 40%;
    opacity: 0.35;
  }


  /* TABLET */

  @media screen and (max-width: 989px) {

    .ai-mosaic__grid-{{ ai_gen_id }} {
      height: {{ block.settings.desktop_height | times: 0.75 | round }}px;
    }

  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    .ai-mosaic__frame-{{ ai_gen_id }} {
      width: 100%;
      padding-left: {{ block.settings.horizontal_padding | at_most: 16 }}px;
      padding-right: {{ block.settings.horizontal_padding | at_most: 16 }}px;
    }

    .ai-mosaic__grid-{{ ai_gen_id }} {
      display: flex;
      flex-wrap: wrap;
      height: auto;
      gap: {{ block.settings.mobile_gap }}px;
    }

    /*
      Featured image
    */

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(5) {
      width: 100%;
      height: {{ block.settings.mobile_image_height }}px;

      {% if block.settings.mobile_featured_position == 'first' %}
        order: 1;
      {% else %}
        order: 10;
      {% endif %}
    }

    /*
      Four small cards
    */

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(1),
    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(2),
    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(3),
    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(4) {
      width: calc(
        50% - ({{ block.settings.mobile_gap }}px / 2)
      );

      height:
        {{ block.settings.mobile_image_height | times: 0.65 | round }}px;

      grid-column: auto;
      grid-row: auto;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(1) {
      order: 2;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(2) {
      order: 3;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(3) {
      order: 4;
    }

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(4) {
      order: 5;
    }

  }


  /* VERY SMALL MOBILE */

  @media screen and (max-width: 420px) {

    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(1),
    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(2),
    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(3),
    .ai-mosaic__card-{{ ai_gen_id }}:nth-child(4) {
      width: 100%;
      height:
        {{ block.settings.mobile_image_height | times: 0.8 | round }}px;
    }

  }

{% endstyle %}


<div
  class="ai-mosaic-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <div class="ai-mosaic__frame-{{ ai_gen_id }}">

    <div class="ai-mosaic__grid-{{ ai_gen_id }}">

      {% for i in (1..5) %}

        {% liquid

          assign image_key = 'image_' | append: i
          assign product_key = 'product_' | append: i
          assign link_key = 'link_' | append: i
          assign source_key = 'source_' | append: i

          assign selected_image = block.settings[image_key]
          assign selected_product = block.settings[product_key]
          assign selected_link = block.settings[link_key]
          assign source_mode = block.settings[source_key]


          if source_mode == 'product' and selected_product != blank

            if selected_product.featured_image != blank
              assign selected_image = selected_product.featured_image
            endif

            assign selected_link = selected_product.url

          endif


          assign image_class = 'ai-mosaic__media-' | append: ai_gen_id

          assign image_alt = selected_image.alt

          if image_alt == blank and selected_product != blank
            assign image_alt = selected_product.title
          endif

          if image_alt == blank
            assign image_alt = 'Footwear collection image'
          endif

        %}


        {% if selected_link != blank %}

          <a
            href="{{ selected_link }}"
            class="ai-mosaic__card-{{ ai_gen_id }}"
            aria-label="{{ image_alt | escape }}"
          >

        {% else %}

          <div class="ai-mosaic__card-{{ ai_gen_id }}">

        {% endif %}


          {% if selected_image != blank %}

            {{
              selected_image
              | image_url: width: 2000
              | image_tag:
                class: image_class,
                loading: 'lazy',
                widths: '360, 540, 720, 960, 1200, 1600, 2000',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: image_alt
            }}

          {% else %}

            <div class="ai-mosaic__placeholder-{{ ai_gen_id }}">

              {{ 'image' | placeholder_svg_tag }}

            </div>

          {% endif %}


        {% if selected_link != blank %}

          </a>

        {% else %}

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>

</div>


