{% doc %}
  @prompt
    Create a styled section heading block that displays the text "Explore Our Collection" to be placed between two sections on the homepage. The heading should match a premium dark-luxe brand aesthetic with: elegant serif or clean sans-serif typography, centered alignment, subtle letter-spacing, a dark background (or transparent to inherit), and light/white text color. Include optional settings for the heading text, font size, and text alignment so it can be customized in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-section-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 24px;
    background: {% if block.settings.transparent_background %}transparent{% else %}{{ block.settings.background_color }}{% endif %};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-section-heading-{{ ai_gen_id }}__title {
    margin: 0;
    color: inherit;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.heading_font.weight }};
    line-height: 1.2;
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-section-heading-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-section-heading-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-section-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-section-heading-{{ ai_gen_id }}__title">{{ block.settings.heading_text | escape }}</h2>
</div>

{% schema %}
{
  "name": "Collection heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Explore Our Collection"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical spacing",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "Use transparent background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#030206"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f7f3e6"
    }
  ],
  "presets": [
    {
      "name": "Collection heading"
    }
  ],
  "tag": null,
  "class": "collection-heading-block"
}
{% endschema %}